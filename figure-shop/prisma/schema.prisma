// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductType {
  IN_STOCK
  PREORDER
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  PRODUCT
  CATEGORY
  BRAND
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  DEMO
  PAYOS
  VNPAY
}

enum PaymentEnvironment {
  LEGACY
  DEMO
  SANDBOX
  LIVE
}

enum PaymentAttemptStatus {
  CREATING
  PENDING
  UNKNOWN
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  wishlist     WishlistItem[]
  conversations AiConversation[]
  reviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  province  String
  district  String
  ward      String
  detail    String
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  products     Product[]         @relation("PrimaryProductCategory")
  productLinks ProductCategory[]
  promotions   Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  products    Product[]
  promotions  Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  price       Int
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  type        ProductType   @default(IN_STOCK)

  categoryId String?
  brandId    String?

  category   Category?         @relation("PrimaryProductCategory", fields: [categoryId], references: [id])
  categories ProductCategory[]
  brand      Brand?            @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  promotion  Promotion?
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlistItems WishlistItem[]
  reviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  userId String
  productId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, productId])
  @@index([productId])
}

model ProductReview {
  id String @id @default(cuid())
  userId String
  productId String
  rating Int
  comment String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model AiConversation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  messages AiMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
}

model AiMessage {
  id Int @id @default(autoincrement())
  conversationId String
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role String
  content String
  products Json?
  createdAt DateTime @default(now())
  @@index([conversationId, id])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Promotion {
  id         String         @id @default(cuid())
  scope      PromotionScope @default(PRODUCT)
  productId  String?        @unique
  categoryId String?
  brandId    String?
  name       String
  type       PromotionType
  value      Int
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean        @default(true)

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([scope, categoryId])
  @@index([scope, brandId])
}

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  name              String
  type              CouponType
  value             Int
  minOrderValue     Int        @default(0)
  maxDiscountAmount Int?
  usageLimit        Int?
  usedCount         Int        @default(0)
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean    @default(true)

  orders Order[]
  carts  Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Cart {
  id       String  @id @default(cuid())
  userId   String  @unique
  couponId String?

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  checkoutKey String?
  checkoutPayloadHash String?
  paymentExpiresAt DateTime?
  cancelRequestedAt DateTime?
  reservationReleasedAt DateTime?
  couponUsageReserved Boolean @default(false)
  isTestOrder Boolean @default(false)

  subtotal             Int
  discountAmount       Int     @default(0)
  shippingFee          Int     @default(0)
  total                Int
  note                 String?
  couponId             String?
  couponCode           String?
  couponDiscountAmount Int     @default(0)

  receiverName  String
  receiverPhone String
  province      String
  district      String
  ward          String
  addressDetail String

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon  Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, checkoutKey])
  @@index([paymentExpiresAt, reservationReleasedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?

  productName    String
  productPrice   Int
  originalPrice  Int    @default(0)
  finalPrice     Int    @default(0)
  discountAmount Int    @default(0)
  quantity       Int
  reservedQuantity Int @default(0)
  total          Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  transactionCode String?
  paidAt          DateTime?
  environment PaymentEnvironment @default(LEGACY)
  needsReview Boolean @default(false)
  reviewReason String?
  attempts PaymentAttempt[]

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentAttempt {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id])
  provider PaymentMethod
  environment PaymentEnvironment
  merchantAccountId String
  providerReference String @unique
  providerPaymentId String?
  providerCreatedAt String
  amount Int
  currency String @default("VND")
  status PaymentAttemptStatus @default(CREATING)
  activePaymentId String? @unique
  requestKey String @unique
  checkoutUrl String?
  expiresAt DateTime
  lastReconciledAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  events PaymentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([paymentId, createdAt])
}

model PaymentEvent {
  id String @id @default(cuid())
  attemptId String
  attempt PaymentAttempt @relation(fields: [attemptId], references: [id])
  eventKey String @unique
  providerTransactionId String?
  amount Int
  result String
  receivedAt DateTime @default(now())
  processedAt DateTime @default(now())
}
