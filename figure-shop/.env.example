DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-strong-secret"
OPENAI_API_KEY=""
AI_MODEL="gpt-5.6-sol"
AI_RATE_LIMIT_PER_MINUTE="10"

# Payment gateways (enable only after credentials and public callbacks are ready)
APP_URL="http://localhost:3000"
PAYOS_ENABLED="false"
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
PAYOS_TEST_ORDERS="true"
VNPAY_ENABLED="false"
VNPAY_ENV="sandbox"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_QUERY_IP="127.0.0.1"
# Set only to a header overwritten by your trusted reverse proxy, e.g. x-real-ip
PAYMENT_CLIENT_IP_HEADER=""
DEMO_PAYMENT_ENABLED="true"
PAYMENT_RESERVATION_MINUTES="15"
